# Cloudinary Configuration (Required for product catalog & images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin Dashboard Password (Required for /admin and /upload)
ADMIN_SECRET=your_super_secret_admin_password

# Public App URL (For local dev: http://localhost:3000, on Vercel: https://your-domain.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

